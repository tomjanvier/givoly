#: includes/Admin/Settings.php:236 templates/admin/settings/tab-email.php:141
msgid "Your tax receipt for {year} — {association}"
msgstr "Votre reçu fiscal {year} — {association}"

#: includes/Admin/Settings.php:241
msgid ""
"Hello {donor_name},\n"
"\n"
"Below is a summary of your donations made in {year}.\n"
"\n"
"Total donated: {amount}\n"
"Number of donations: {donation_count}\n"
"Organization: {association}\n"
"Address: {association_address}\n"
"SIRET: {siret}\n"
"RNA: {rna}\n"
"Tax approval / ruling: {fiscal_id}\n"
"\n"
"This message helps with year-end reporting. Verify the organization's "
"information and attach your official tax receipt if required before using it "
"as supporting documentation.\n"
"\n"
"Thank you for your support."
msgstr ""
"Bonjour {donor_name},\n"
"\n"
"Vous trouverez ci-dessous le récapitulatif de vos dons réalisés en {year}.\n"
"\n"
"Montant total : {amount}\n"
"Nombre de dons : {donation_count}\n"
"Association : {association}\n"
"Adresse : {association_address}\n"
"SIRET : {siret}\n"
"RNA : {rna}\n"
"Agrément / rescrit fiscal : {fiscal_id}\n"
"\n"
"Ce message facilite l'envoi de fin d'année. Vérifiez les informations de "
"l'association et joignez votre reçu fiscal officiel si nécessaire avant "
"utilisation comme justificatif.\n"
"\n"
"Merci pour votre soutien."

